<?php

declare(strict_types=1);

session_start();
date_default_timezone_set('Europe/Lisbon');

define('BASE_PATH', dirname(__DIR__));

require BASE_PATH . '/app/config/config.php';
require BASE_PATH . '/app/core/Database.php';
require BASE_PATH . '/app/core/View.php';
require BASE_PATH . '/app/core/Auth.php';
require BASE_PATH . '/app/core/helpers.php';

$autoload = BASE_PATH . '/vendor/autoload.php';
if (file_exists($autoload)) {
    require $autoload;
}

$uri = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
$scriptName = str_replace('\\', '/', dirname($_SERVER['SCRIPT_NAME']));
$basePath = rtrim($scriptName, '/');
$route = '/' . trim(str_replace($basePath, '', $uri), '/');
$route = $route === '/' ? '/' : rtrim($route, '/');

switch ($route) {
    case '/':
        if (\App\Core\Auth::check()) {
            require BASE_PATH . '/app/controllers/OperationController.php';
            (new \App\Controllers\OperationController())->index();
            exit;
        }
        require BASE_PATH . '/app/controllers/AuthController.php';
        (new \App\Controllers\AuthController())->loginForm();
        exit;

    case '/login':
        require BASE_PATH . '/app/controllers/AuthController.php';
        $controller = new \App\Controllers\AuthController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->login();
            exit;
        }
        $controller->loginForm();
        exit;

    case '/auth/google':
        require BASE_PATH . '/app/controllers/AuthController.php';
        (new \App\Controllers\AuthController())->googleRedirect();
        exit;

    case '/auth/google/callback':
        require BASE_PATH . '/app/controllers/AuthController.php';
        (new \App\Controllers\AuthController())->googleCallback();
        exit;

    case '/register':
        require BASE_PATH . '/app/controllers/AuthController.php';
        $controller = new \App\Controllers\AuthController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->register();
            exit;
        }
        $controller->registerForm();
        exit;

    case '/forgot-password':
        require BASE_PATH . '/app/controllers/AuthController.php';
        $controller = new \App\Controllers\AuthController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->forgotPassword();
            exit;
        }
        $controller->forgotPasswordForm();
        exit;

    case '/reset-password':
        require BASE_PATH . '/app/controllers/AuthController.php';
        $controller = new \App\Controllers\AuthController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->resetPassword();
            exit;
        }
        $controller->resetPasswordForm();
        exit;

    case '/account':
        require BASE_PATH . '/app/controllers/AuthController.php';
        $controller = new \App\Controllers\AuthController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->updateAccount();
            exit;
        }
        $controller->account();
        exit;

    case '/logout':
        require BASE_PATH . '/app/controllers/AuthController.php';
        (new \App\Controllers\AuthController())->logout();
        exit;

    case '/entry/store':
        require BASE_PATH . '/app/controllers/OperationController.php';
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            (new \App\Controllers\OperationController())->store();
            exit;
        }
        http_response_code(405);
        exit('Método não permitido.');

    case '/stores/quick-create':
        require BASE_PATH . '/app/controllers/StoreController.php';
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            (new \App\Controllers\StoreController())->quickCreate();
            exit;
        }
        http_response_code(405);
        exit('Método não permitido.');

    case '/history':
        require BASE_PATH . '/app/controllers/HistoryController.php';
        (new \App\Controllers\HistoryController())->index();
        exit;

    case '/history/edit':
        require BASE_PATH . '/app/controllers/HistoryController.php';
        $controller = new \App\Controllers\HistoryController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->update();
            exit;
        }
        $controller->editForm();
        exit;

    case '/history/delete':
        require BASE_PATH . '/app/controllers/HistoryController.php';
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            (new \App\Controllers\HistoryController())->delete();
            exit;
        }
        http_response_code(405);
        exit('Método não permitido.');

    case '/history/reopen-day':
        require BASE_PATH . '/app/controllers/HistoryController.php';
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            (new \App\Controllers\HistoryController())->reopenDay();
            exit;
        }
        http_response_code(405);
        exit('Método não permitido.');

    case '/export/pdf':
        require BASE_PATH . '/app/controllers/ReportController.php';
        (new \App\Controllers\ReportController())->pdf();
        exit;

    case '/report/monthly-preview':
        require BASE_PATH . '/app/controllers/ReportController.php';
        (new \App\Controllers\ReportController())->monthlyPreview();
        exit;

    case '/report/monthly-download':
        require BASE_PATH . '/app/controllers/ReportController.php';
        (new \App\Controllers\ReportController())->monthlyDownload();
        exit;

    case '/send/email':
        require BASE_PATH . '/app/controllers/ReportController.php';
        (new \App\Controllers\ReportController())->email();
        exit;

    case '/settings':
        require BASE_PATH . '/app/controllers/SettingsController.php';
        $controller = new \App\Controllers\SettingsController();
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $controller->save();
            exit;
        }
        $controller->index();
        exit;

    default:
        http_response_code(404);
        echo '404 - Página não encontrada';
        exit;
}